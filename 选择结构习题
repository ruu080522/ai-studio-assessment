#include <stdio.h>
int main()
{
    int a,b;
    scanf("%d%d",&a,&b);
    if(a>b)
        printf("%d>%d\n",a,b);
    else if(a<b)
        printf("%d<%d\n",a,b);
    else
        printf("%d=%d\n",a,b);
    return 0;
}

卡拉兹函数
#include <stdio.h>
int main()
{
    int n;
    scanf("%d",&n);
    if(n%2==0)
        n = n/2;
    else
        n = 3*n+1;
    printf("%d\n",n);
    return 0;
}

