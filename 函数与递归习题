#include <stdio.h>
int f(int n)
{
    if(n==1)return 2;
    if(n==2)return 3;
    if(n==3)return 3;
    return f(n-1)+f(n-2);
}
int main()
{
    int n;
    scanf("%d",&n);
    printf("%d\n",f(n));
    return 0;
}
