#include <stdio.h>
int fun(int x)
{
    int sum=0;
    while(x)
    {
        sum+= x%10;
        x/=10;
    }
    return sum;
}
int main()
{
    int n;
    scanf("%d",&n);
    printf("%d\n",fun(n));
    return 0;
}

C 素数回文
#include <stdio.h>
int isPrime(int x)
{
    if(x<2) return 0;
    for(int i=2;i*i<=x;i++)
    {
        if(x%i==0) return 0;
    }
    return 1;
}
int isHuiwen(int x)
{
    int t=x,rev=0;
    while(t)
    {
        rev=rev*10+t%10;
        t/=10;
    }
    return rev==x;
}
int main()
{
    int n;
    scanf("%d",&n);
    if(isPrime(n) && isHuiwen(n))
        printf("Yes\n");
    else
        printf("No\n");
    return 0;
}

