#include <stdio.h>
int count(int x)
{
    int cnt=0;
    while(x)
    {
        if(x%10==2) cnt++;
        x /= 10;
    }
    return cnt;
}
int main()
{
    int l,r,i,ans=0;
    scanf("%d%d",&l,&r);
    for(i=l;i<=r;i++)
    {
        ans+= count(i);
    }
    printf("%d\n",ans);
    return 0;
}

