1001 上下金字塔
#include <stdio.h>
int main()
{
    int n,i,j;
    scanf("%d",&n);
    for(i=1;i<=n;i++)
    {
        for(j=1;j<=n-i;j++) printf(" ");
        for(j=1;j<=2*i-1;j++) printf("*");
        printf("\n");
    }
    for(i=n-1;i>=1;i--)
    {
        for(j=1;j<=n-i;j++) printf(" ");
        for(j=1;j<=2*i-1;j++) printf("*");
        printf("\n");
    }
    return 0;
}

1002 数字三角形
