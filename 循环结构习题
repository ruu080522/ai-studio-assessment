1003 字符金字塔
#include <stdio.h>
int main()
{
    int n,i,j;
    char ch;
    scanf("%d %c",&n,&ch);
    for(i=1;i<=n;i++)
    {
        for(j=1;j<=n-i;j++) printf(" ");
        for(j=1;j<=2*i-1;j++) printf("%c",ch);
        printf("\n");
    }
    return 0;
}

