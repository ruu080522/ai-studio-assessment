1001 随机序列
#include <stdio.h>
int main()
{
    int a[1005],n,i;
    scanf("%d",&n);
    for(i=0;i<n;i++)
    {
        scanf("%d",&a[i]);
    }
    for(i=0;i<n;i++)
    {
        printf("%d ",a[i]);
    }
    return 0;
}

1002 [NOIP2013]
#include <stdio.h>
int main()
{
    int n,x,i,cnt=0;
    scanf("%d%d",&n,&x);
    for(i=1;i<=n;i++)
    {
        int tmp=i;
        while(tmp)
        {
            if(tmp%10==x) cnt++;
            tmp /=10;
        }
    }
    printf("%d\n",cnt);
    return 0;
}

1003 约瑟夫环
#include <stdio.h>
int main()
{
    int n,m,i,res=0;
    scanf("%d%d",&n,&m);
    for(i=2;i<=n;i++)
    {
        res=(res + m)%i;
    }
    printf("%d\n",res+1);
    return 0;
}

1004 [NOIP2005] 
#include <stdio.h>
int main()
{
    int tree[10005]={0};
    int L,m,i,l,r,sum=0;
    scanf("%d%d",&L,&m);
    while(m--)
    {
        scanf("%d%d",&l,&r);
        for(i=l;i<=r;i++)
        {
            tree[i]=1;
        }
    }
    for(i=0;i<=L;i++)
    {
        if(tree[i]==0) sum++;
    }
    printf("%d\n",sum);
    return 0;
}

